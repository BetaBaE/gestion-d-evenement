# Relative: the Vite dev server proxies /api to the backend (see vite.config.js),
# and in production Nginx serves the front and proxies /api on the same domain.
VITE_API_URL=/api

# Serve the dev server over HTTPS (self-signed certificate). Needed to use the
# camera on the scan page from a phone on the LAN: phones only allow it on HTTPS.
# The phone shows a certificate warning once; accept it to continue.
VITE_HTTPS=true
