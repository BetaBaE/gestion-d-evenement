PORT=4000
MONGODB_URI=mongodb://localhost:27017/event_registration
JWT_SECRET=change_me
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Public base URL of this API, used for absolute image links in emails (e.g. the organisateur's logo).
PUBLIC_API_URL=http://localhost:4000/api
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inscriptions <no-reply@example.com>"
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_me

# Encryption key for per-organisateur SMTP credentials (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_SETTINGS_ENCRYPTION_KEY=
UPLOAD_MAX_MB=5

# Time zone used for day boundaries (scan link window: start of first day → end of last day).
APP_TIMEZONE=Africa/Casablanca
