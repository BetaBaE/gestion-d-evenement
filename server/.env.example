PORT=4000
MONGODB_URI=mongodb://localhost:27017/event_registration
JWT_SECRET=change_me
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Public base URL of this API, used for absolute image links in emails (e.g. the organisateur's logo).
PUBLIC_API_URL=http://localhost:4000/api
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inscriptions <no-reply@example.com>"
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_me

# Encryption key for per-organisateur SMTP credentials (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_SETTINGS_ENCRYPTION_KEY=
UPLOAD_MAX_MB=5

# Time zone used for day boundaries (scan link window: start of first day → end of last day).
APP_TIMEZONE=Africa/Casablanca

# Reverse proxies in front of the API (Express "trust proxy"), so the visitor's IP is known.
# Vercel: leave empty (1 is used automatically). Behind Nginx/Caddy on a VPS: TRUST_PROXY=1.
TRUST_PROXY=

# Cloudflare Turnstile (bot check on the back-office login and the public registration form).
# Off when unset. Create the widget at dash.cloudflare.com -> Turnstile (see README).
# Test keys (no internet account needed, but the check still calls Cloudflare):
#   always passes: secret 1x0000000000000000000000000000000AA (site key 1x00000000000000000000AA)
#   always fails:  secret 2x0000000000000000000000000000000AA (site key 2x00000000000000000000AB)
TURNSTILE_ENABLED=false
# Secret key: server only, never sent to the browser.
TURNSTILE_SECRET_KEY=
# Hostnames a token may come from (the real widget's hostnames).
TURNSTILE_ALLOWED_HOSTNAMES=event.atner.ma,gestion-d-evenement.vercel.app,localhost
# Emergency switch: if Cloudflare is unreachable, let logins through (logged). Invalid tokens are still refused.
TURNSTILE_LOGIN_FAIL_OPEN=false
