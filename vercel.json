{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci --prefix server && npm ci --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "{shared/badge-renderer/**,server/node_modules/pdfjs-dist/standard_fonts/**,server/node_modules/pdfjs-dist/cmaps/**,server/node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
